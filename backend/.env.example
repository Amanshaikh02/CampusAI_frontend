PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_ai?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URLs for CORS (Set to your Vercel deployment URL without trailing slash)
FRONTEND_URL=https://campusai-frontend.vercel.app
CLIENT_URL=https://campusai-frontend.vercel.app
